server {
    listen 443 ssl;
    server_name test.local;

    ssl_certificate /etc/ssl/test.local/test.local.crt;
    ssl_certificate_key /etc/ssl/test.local/test.local.key;
    
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers on;
    ssl_ciphers "EECDH+AESGCM:EDH+AESGCM:AES256+EECDH:AES256+EDH";

    # Проксирование для фронтенда
    location /front/ {
        alias /var/www/frontend/;
        try_files $uri $uri/ /index.html;
    }

    location /gitea/ {
        proxy_pass http://gitea:3000/;  # Gitea по умолчанию слушает 3000 порт
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        

        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_buffering off;
    }


    location /jenkins/ {
        proxy_pass http://gitea:8080/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        

        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_buffering off;
    }

    # Корневой URL можно перенаправить на фронтенд
    location = / {
        return 302 /front/;
    }
}